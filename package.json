{
  "name": "wedding-dj-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline-first wedding reception DJ console",
  "author": "Wedding DJ Console",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:audio": "node scripts/audio-smoke.mjs",
    "build": "npm run typecheck && vite build",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "pack:win": "npm run build && electron-builder --win --dir",
    "build:guest": "vite build --mode guest",
    "test:rules": "node scripts/firebase-test.mjs rules",
    "test:firebase": "node scripts/firebase-test.mjs all",
    "check:secrets": "node scripts/check-secrets.mjs",
    "security:install-hook": "node scripts/install-security-hook.mjs",
    "test:secrets": "node --test scripts/check-secrets.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "firebase-tools": "^15.33.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "build": {
    "appId": "com.weddingdj.console",
    "productName": "Wedding DJ Console",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
